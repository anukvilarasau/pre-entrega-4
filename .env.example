# Copiá este archivo como .env y completá tus claves reales.
# El archivo .env está en .gitignore: NUNCA se sube a GitHub.

# Clave de Pinecone: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# Clave de Anthropic (solo la usa ask.py): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Nombre del índice en Pinecone (minúsculas, números y guiones)
INDEX_NAME=fastapi-docs

# Namespace dentro del índice donde se guardan los vectores
PINECONE_NAMESPACE=fastapi-v1

# Opcional (solo ask.py). Por defecto: claude-sonnet-4-6 con temperatura 0.
# Los modelos Claude 4.7 en adelante (ej. claude-opus-5-5) rechazan "temperature":
# si usás uno de esos, dejá TEMPERATURE vacía (TEMPERATURE=).
# ANTHROPIC_MODEL=claude-sonnet-4-6
# TEMPERATURE=0
